#!/bin/bash

while true; do
    l=$(niri msg keyboard-layouts | sed -n 's/^ \* //p')

    if [[ $l == "0 English (US)" ]]; then
        echo "en"
    elif [[ $l == "1 Urdu (Pakistan)" ]]; then
        echo "اردو"
    elif [[ $l == "2 US keyboard with french symbols - AltGr combination" ]]; then
        echo "fr"
    else
        echo $l
    fi
done
